{
  "name": "flash-osidian-sync",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "build:plugin": "esbuild packages/plugin/src/main.ts --bundle --platform=browser --format=cjs --target=es2022 --external:obsidian --external:@codemirror/view --outfile=packages/plugin/dist/main.js",
    "build:server-cli": "node scripts/build-server-cli.mjs",
    "test:server-cli-bundle": "npm run build:server-cli && vitest run tests/integration/server-cli-bundle.test.ts",
    "build:server-admin-worker": "node scripts/build-server-cli.mjs worker",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:simulation": "vitest run tests/simulation --passWithNoTests"
  },
  "devDependencies": {
    "@codemirror/view": "^6.0.0",
    "@eslint/js": "^9.0.0",
    "@nats-io/transport-node": "^3.4.0",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "node": "^22.0.0",
    "obsidian": "^1.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
